# Optional. If unset, the agent runs in DEMO_MODE (rule-based planner, no API cost).
ANTHROPIC_API_KEY=

# Model to use when ANTHROPIC_API_KEY is set.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Defaults to a local SQLite file at data/app.db.
# Example Postgres: postgresql+psycopg2://user:pass@localhost:5432/analyst_agent
DATABASE_URL=
